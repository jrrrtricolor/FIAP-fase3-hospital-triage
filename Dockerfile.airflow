# syntax=docker/dockerfile:1

# Builder e runtime reutilizam as mesmas camadas da imagem Python.
FROM apache/airflow:3.3.1-python3.12

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENV POETRY_VERSION=2.4.1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_CACHE_DIR=/tmp/poetry-cache

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends locales \
    && sed -i 's/^# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

USER airflow
RUN python -m pip install --no-cache-dir "poetry==$POETRY_VERSION"

WORKDIR /app

COPY --chown=airflow:root pyproject.toml poetry.lock ./

RUN poetry install --only main --no-root --no-ansi \
    && rm -rf "$POETRY_CACHE_DIR"

COPY --chown=airflow:root src ./src
COPY --chown=airflow:root ml_prep_kit ./ml_prep_kit
COPY --chown=airflow:root data ./data

WORKDIR /opt/airflow

ENV PYTHONPATH="/app:/app/src:/app/ml_prep_kit/src"
